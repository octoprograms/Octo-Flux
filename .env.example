# Copy to .env and fill in. OctoProxy does not auto-load .env — export these
# into the process environment yourself (systemd EnvironmentFile=, docker
# --env-file, `set -a; source .env; set +a`, etc.) so the choice of loader
# stays outside the application.

# Client-facing OctoProxy key(s) — what YOUR applications send as
# Authorization: Bearer <this>. Comma-separated if you list multiple in
# server.client_keys via multiple env vars, or just reference one here.
OCTOPROXY_CLIENT_KEY=change-me-to-a-random-string

# Upstream provider credentials referenced from config/octoproxy.yaml
GROQ_API_KEY_1=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
BYTEZ_API_KEY=

# Which config file to load (default: config/octoproxy.yaml)
OCTOPROXY_CONFIG=config/octoproxy.yaml

# DEBUG | INFO | WARNING | ERROR
OCTOPROXY_LOG_LEVEL=INFO
