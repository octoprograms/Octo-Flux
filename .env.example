# Copy to .env and fill in. OctoFlux does not auto-load .env — export these
# into the process environment yourself (systemd EnvironmentFile=, docker
# --env-file, `set -a; source .env; set +a`, etc.) so the choice of loader
# stays outside the application.

# Client-facing OctoFlux key(s) — what YOUR applications send as
# Authorization: Bearer <this>. Comma-separated if you list multiple in
# server.client_keys via multiple env vars, or just reference one here.
OctoFlux_CLIENT_KEY=change-me-to-a-random-string

# Upstream provider credentials referenced from config/OctoFlux.yaml
GROQ_API_KEY_1=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
BYTEZ_API_KEY=

# Which config file to load (default: config/OctoFlux.yaml)
OctoFlux_CONFIG=config/OctoFlux.yaml

# DEBUG | INFO | WARNING | ERROR
OctoFlux_LOG_LEVEL=INFO
